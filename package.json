{
  "name": "korean-learning-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "run:all": "node scripts/run-all.mjs",
    "run:web": "corepack pnpm --filter @korean-learning/web dev",
    "run:gateway": "corepack pnpm --filter @korean-learning/api-gateway dev",
    "run:content": "corepack pnpm --filter @korean-learning/content-service dev",
    "run:analytics": "corepack pnpm --filter @korean-learning/analytics-service dev",
    "run:mobile": "corepack pnpm mobile:dev",
    "mobile:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/mobile.ps1 check",
    "mobile:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/mobile.ps1 backend",
    "mobile:sync": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/mobile.ps1 sync",
    "mobile:android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/mobile.ps1 android",
    "mobile:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/mobile.ps1 dev",
    "mobile:open": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/mobile.ps1 open",
    "mobile:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/mobile.ps1 stop",
    "run:user": "cd apps/user-service && uvicorn app.main:app --reload --host 0.0.0.0 --port 8001",
    "run:ai": "cd apps/ai-service && uvicorn app.main:app --reload --host 0.0.0.0 --port 3004",
    "typecheck": "corepack pnpm --recursive run typecheck",
    "test": "corepack pnpm --recursive run test",
    "log": "node scripts/append-change-log.mjs"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
