# Local docker compose. One Postgres server, one database per service.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Optional. Copied into the web bundle at image build.
GOOGLE_CLIENT_ID=

# Render: one service for the whole app. Paste the Internal Database URL.
# POSTGRES_URL=postgresql://user:password@dpg-....-a/database_name
