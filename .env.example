# Local docker compose. One Postgres server, one database per service.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Optional. Copied into the web bundle at image build.
GOOGLE_CLIENT_ID=

# Render backend service (repo root). Paste the Internal Database URL.
# POSTGRES_URL=postgresql://user:password@dpg-....-a/database_name

# Same LLM settings as apps/ai-service/.env. Put these on the backend Render service.
# Copy LLM_API_KEY from that file. Do not commit the key.
LLM_PROVIDER=openai
LLM_MODEL=qwen/qwen-2.5-7b-instruct
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=90
LLM_TOTAL_TIMEOUT_SECONDS=150
MAX_CONTEXT_MESSAGES=12
MAX_CONTEXT_TOKENS=6000
# Public web URL after the web service is deployed, for example https://web-name.onrender.com
FRONTEND_ORIGIN=
