# Sao chép file này thành .env. Không commit .env vì chứa secret.

# PostgreSQL user-service khi kết nối từ máy host.
USER_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/user_service

# Tạo bằng: openssl rand -hex 32
USER_JWT_SECRET=replace-with-a-long-random-secret

# Các email được nhận role ADMIN khi đăng ký, phân cách bằng dấu phẩy.
USER_ADMIN_EMAILS=admin@example.com

# OAuth Web Client ID từ Google Auth Platform.
# Authorized JavaScript origins: http://localhost:8080 và http://127.0.0.1:8080
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Origin frontend cho CORS và URL FastAPI được nhúng khi build React.
FRONTEND_URL=http://localhost:5173
USER_API_URL=http://localhost:8001/api/v1

# API Gateway host-development variables.
PORT=3000
USER_SERVICE_URL=http://localhost:8001
CONTENT_SERVICE_URL=http://localhost:3001
CONTENT_API_URL=http://localhost:3001/api/v1/content
ANALYTICS_SERVICE_URL=http://localhost:3003
AI_SERVICE_URL=http://localhost:3004

# --- Email (local) ---
# Mặc định Docker Compose dùng Mailpit: mở http://localhost:8025 xem OTP.
# Không cần Gmail để dev. Chỉ đổi sang Gmail khi đã có App Password.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=kits@local.test
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false

# --- Email (Gmail thật, tùy chọn) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_FROM=your-sender@gmail.com
# SMTP_USERNAME=your-sender@gmail.com
# SMTP_PASSWORD=your-16-character-google-app-password
# SMTP_USE_TLS=true

# --- AI Service (Groq, OpenAI-compatible) ---
# Chat thật cần LLM_API_KEY từ https://console.groq.com/keys
LLM_PROVIDER=openai
LLM_MODEL=qwen/qwen3.6-27b
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TEMPERATURE=0.2
MAX_CONTEXT_MESSAGES=12
MAX_CONTEXT_TOKENS=6000
AI_FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:8081,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:8081
# Docker UI dùng cùng origin (để trống). Vite local cũng để trống + proxy.
AI_API_URL=

# Database và message broker của các service khác.
CONTENT_DATABASE_URL=postgresql://postgres:postgres@localhost:5434/content_service
AI_DATABASE_URL=postgresql://postgres:postgres@localhost:5436/ai_service
ANALYTICS_DATABASE_URL=postgresql://postgres:postgres@localhost:5437/analytics_service
# File store hiện tại (Docker volume /data). Prisma sau này dùng ANALYTICS_DATABASE_URL.
ANALYTICS_DATA_FILE=.analytics-data.json
RABBITMQ_URL=amqp://guest:guest@localhost:5672
