# API Gateway URL. Do not use the Vite frontend URL.
BASE_URL=http://localhost:3000
TARGET_ENV=local

# Prefer a short-lived token. Otherwise use a dedicated seeded test account.
TEST_AUTH_TOKEN=
TEST_USERNAME=
TEST_PASSWORD=

# Safety gates. stress, spike, soak, and capacity require CONFIRM_HIGH_LOAD=true.
ALLOW_NON_LOCAL_TESTS=false
CONFIRM_HIGH_LOAD=false
# Ceiling for constant-arrival-rate, not a measured capacity.
MAX_VUS=100

# Trial thresholds for GET APIs. Not a release SLO.
P95_LIMIT_MS=500
P99_LIMIT_MS=1000
ERROR_RATE_LIMIT=0.01

# Scenario tuning.
THINK_TIME_SECONDS=1
SMOKE_VUS=1
SMOKE_DURATION=1m
HOLD_DURATION=3m
SOAK_VUS=30
SOAK_DURATION=30m
VUS=20
RATE=10
PRE_ALLOCATED_VUS=30
CHAT_ITERATIONS=3
