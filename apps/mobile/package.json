{
  "name": "@korean-learning/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:web": "corepack pnpm --filter @korean-learning/web build",
    "sync": "corepack pnpm run build:web && cap sync android",
    "copy": "cap copy android",
    "open:android": "cap open android",
    "run:android": "cap run android",
    "android": "corepack pnpm run sync && cap run android"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "7.1.6",
    "@capacitor/android": "7.6.9",
    "@capacitor/app": "7.1.2",
    "@capacitor/core": "7.6.9"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.9",
    "@types/node": "^22.15.3"
  }
}
