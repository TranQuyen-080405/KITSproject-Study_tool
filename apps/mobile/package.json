    "expo-dev-client": "~5.2.4",
    "expo-secure-store": "~14.2.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-web": "^0.20.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "~19.0.10",
    "@types/react-dom": "~19.0.6",
    "jsdom": "^26.1.0"
