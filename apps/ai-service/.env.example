POSTGRES_DB=chatbot_service
POSTGRES_USER=chatbot_user
POSTGRES_PASSWORD=change-this-password
POSTGRES_PORT=5432

# Used when running the backend directly, outside Docker.
DATABASE_URL=postgresql+asyncpg://chatbot_user:change-this-password@localhost:5432/chatbot_service
LLM_PROVIDER=openai
LLM_MODEL=qwen/qwen3.6-27b
LLM_API_KEY=your-groq-api-key
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TEMPERATURE=0.2
# Per attempt / full model call including fallbacks (seconds)
LLM_TIMEOUT_SECONDS=30
LLM_TOTAL_TIMEOUT_SECONDS=45
MAX_CONTEXT_MESSAGES=12
MAX_CONTEXT_TOKENS=6000
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:8081
# Validates bearer access tokens and account status.
USER_SERVICE_URL=http://localhost:8001

# Standalone AI Docker stack reaches User Service on the host.
AI_DOCKER_USER_SERVICE_URL=http://host.docker.internal:8001
