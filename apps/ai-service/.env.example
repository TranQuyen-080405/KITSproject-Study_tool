POSTGRES_DB=chatbot_service
POSTGRES_USER=chatbot_user
POSTGRES_PASSWORD=change-this-password
POSTGRES_PORT=5432

# Used when running the backend directly, outside Docker.
DATABASE_URL=postgresql+asyncpg://chatbot_user:change-this-password@localhost:5432/chatbot_service
LLM_PROVIDER=openai
LLM_MODEL=qwen/qwen3.6-27b
LLM_API_KEY=your-groq-api-key
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TEMPERATURE=0.2
MAX_CONTEXT_MESSAGES=12
MAX_CONTEXT_TOKENS=6000
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:8081
